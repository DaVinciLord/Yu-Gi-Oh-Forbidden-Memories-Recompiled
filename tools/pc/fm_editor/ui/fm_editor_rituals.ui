  <property name="styleSheet"><string notr="true">QMainWindow,QWidget#centralwidget{background:#08131f;color:#dbe6f3;font:13px "Segoe UI";} QFrame#topBar{background:#0d1927;border:1px solid #26384d;border-radius:7px;} QFrame#sidebar{background:#0a1624;border-right:1px solid #26384d;} QFrame#ritualPanel,QFrame#recipePanel,QFrame#tribute1Panel,QFrame#tribute2Panel,QFrame#tribute3Panel,QFrame#resultPanel{background:#101d2b;border:1px solid #263a50;border-radius:8px;} QLabel#appTitle{font-size:20px;font-weight:700;color:#f2f6fc;} QLabel#pageTitle{font-size:19px;font-weight:700;color:#f2f6fc;} QLabel#panelTitle,QLabel#recipeTitle{font-size:16px;font-weight:700;color:#eaf1fa;} QLabel#gameLoaded{color:#20c88a;font-weight:700;} QPushButton{min-height:30px;padding:0 12px;background:#152437;border:1px solid #3a4e67;border-radius:6px;color:#dce6f2;} QPushButton:hover{background:#1a2d44;} QPushButton#saveButton,QPushButton#ritualNav,QPushButton#menuButton{background:#2276f5;border-color:#2f80ff;color:white;font-weight:700;} QLineEdit,QComboBox,QSpinBox{min-height:30px;background:#152437;border:1px solid #334a63;border-radius:5px;padding:0 8px;color:#e5ecf5;} QTableWidget{background:#0c1927;alternate-background-color:#122234;border:1px solid #263a50;gridline-color:#263a50;color:#d5dfeb;selection-background-color:#2276f5;selection-color:white;} QHeaderView::section{background:#16273a;color:#bfcddd;padding:7px;border:0;border-right:1px solid #263a50;font-weight:700;} QLabel[cardPreview="true"]{background:#0b1725;border:1px solid #35506c;border-radius:6px;color:#8094aa;font-weight:600;}</string></property>
