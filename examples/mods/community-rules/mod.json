{
    "id": "example-community-rules",
    "name": "Community rules example",
    "version": "1.0",
    "author": "DecompRecomp",
    "description": "The rules community mods change, without code: a fixed CPU deck, starchips for a full chest, terrain and equip bonuses, trap thresholds, a higher ATK/DEF cap and more life points. Values made up for the example.",
    "enabled": false,
    "chest_overflow": {"limit": 99, "starchips": 2},
    "terrain_bonus": {
        "Forest": {"Beast": -300, "Insect": 300, "Plant": 250},
        "Umi": {"Aqua": 400, "Machine": -400}
    },
    "equip_bonus_default": 700,
    "equips": [
        {"card": "Legendary Sword", "bonus": 300, "bonus_if": {"Warrior": 800, "Light": 600}},
        {"card": "Megamorph", "bonus": 1500}
    ],
    "trap_thresholds": {"House of Adhesive Tape": 800, "Acid Trap Hole": 3500},
    "limits": {"stats": 30000, "life_points": {"start": 16000, "max": 30000}},
    "decks": {
        "Simon Muran": {"fixed": true, "Kuriboh": 4, "Mystical Elf": 6, "Celtic Guardian": 5,
                        "Baby Dragon": 5, "Time Wizard": 20}
    }
}
